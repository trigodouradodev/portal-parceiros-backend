/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model activity_interactions {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id              String         @unique(map: "activity_interactions_task_id_unique") @db.Uuid
  installment_id       String         @db.Uuid
  contract_id          String         @db.Uuid
  task_type            String         @db.VarChar(255)
  channel              String         @db.VarChar(255)
  recipient_type       String         @db.VarChar(255)
  recipient_contact_id String?        @db.Uuid
  result               String         @db.VarChar(255)
  promise_date         DateTime?      @db.Date
  observation          String?
  user_id              String         @db.Uuid
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  contracts            contracts      @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_interactions_contract_id_foreign")
  installments         installments   @relation(fields: [installment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_interactions_installment_id_foreign")
  activity_tasks       activity_tasks @relation(fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_interactions_task_id_foreign")
  trigo_users          trigo_users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_interactions_user_id_foreign")
  geolocations         geolocations?

  @@index([contract_id, created_at], map: "idx_activity_interactions_contract")
  @@index([installment_id, created_at], map: "idx_activity_interactions_installment")
  @@schema("public")
}

