  interest_rate          Decimal          @db.Decimal(12, 8)
  installment_numbers    Int
  first_installment_date DateTime         @db.Date
  installment_amount     Decimal          @db.Decimal(15, 2)
  simulation_result      Json?
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  finance_products       finance_products @relation(fields: [finance_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "simulations_finance_product_id_foreign")
  parties                parties?         @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "simulations_party_id_foreign")
  trigo_users            trigo_users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "simulations_user_id_foreign")
  quotes                 quotes?

  @@index([document], map: "simulations_document_index")
