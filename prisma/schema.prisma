  parent_task_id                                               String?                @db.Uuid
  reschedule_count                                             Int                    @default(0)
  activity_interactions                                        activity_interactions?
  trigo_users_activity_tasks_assigned_toTotrigo_users          trigo_users?           @relation("activity_tasks_assigned_toTotrigo_users", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_tasks_assigned_to_foreign")
  trigo_users_activity_tasks_completed_by_user_idTotrigo_users trigo_users?           @relation("activity_tasks_completed_by_user_idTotrigo_users", fields: [completed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_tasks_completed_by_user_id_foreign")
  contracts                                                    contracts              @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_tasks_contract_id_foreign")
  trigo_users_activity_tasks_created_by_user_idTotrigo_users   trigo_users?           @relation("activity_tasks_created_by_user_idTotrigo_users", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_tasks_created_by_user_id_foreign")
