  activity_ruler_stages                                        activity_ruler_stages? @relation(fields: [ruler_stage_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_tasks_ruler_stage_id_foreign")

  @@index([assigned_to, expire_date], map: "idx_activity_tasks_assigned_pending", where: raw("((status)::text = 'pending'::text)"))
  @@index([contract_id, created_at], map: "idx_activity_tasks_contract")
  @@index([installment_id, created_at], map: "idx_activity_tasks_installment")
  @@schema("public")
}

